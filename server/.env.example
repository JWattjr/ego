# Copy to .env.local (never commit). Fill in yourself; never paste keys into an AI chat.
CHAIN_ID=5042
RPC_URL=https://rpc.mainnet.arc.io
EXPLORER_URL=https://explorer.arc.io
CONTRACT_ADDRESS=
# Ego signer: a fresh key used ONLY to sign claim approvals. Holds no money.
SIGNER_PRIVATE_KEY=
# Upstash Redis (Vercel Marketplace > Upstash) adds these automatically when linked.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# The app's URL, for CORS.
APP_ORIGIN=
# Signs "this email is verified" sessions. Any long random string.
SESSION_SECRET=
# Fresh wallet that pays claim gas for winners (fund with ~1 USDC on Arc). Holds only gas money.
RELAYER_PRIVATE_KEY=
# Email sending (verification codes + "you won" emails). Gmail: smtp.gmail.com, 465, your address, an app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
