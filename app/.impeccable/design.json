      "html": "<div class=\"ds-coin\" aria-hidden=\"true\"><span class=\"ds-orbit\"></span><span class=\"ds-dollar\">$</span><span class=\"ds-notch ds-one\"></span><span class=\"ds-notch ds-two\"></span></div>",
