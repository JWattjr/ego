      "html": "<article class=\"ds-card\"><div class=\"ds-art\"><span class=\"ds-art-orbit ds-orbit-one\"></span><span class=\"ds-art-orbit ds-orbit-two\"></span><div class=\"ds-coin\" aria-hidden=\"true\"><span class=\"ds-orbit\"></span><span class=\"ds-dollar\">$</span><span class=\"ds-notch ds-one\"></span><span class=\"ds-notch ds-two\"></span></div><span class=\"ds-dot ds-dot-one\"></span><span class=\"ds-dot ds-dot-two\"></span></div><div class=\"ds-copy\"><span class=\"ds-small\">Enugu edition · map drop</span><h3>Good things nearby</h3><p>From a local creator</p><span class=\"ds-stamp\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg>Collected on Arc</span></div></article>",
      "css": ".ds-coin{position:relative;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--blue, #1760dd);color:var(--white, #fff);box-shadow:inset -5px -7px 0 rgba(0,38,115,.13);width:80px;height:80px}.ds-orbit{position:absolute;inset:11%;border:2px solid #fff;border-radius:50%;opacity:.75}.ds-dollar{font-family:\"Manrope\", sans-serif;font-size:42px;font-weight:600;line-height:1}.ds-notch{position:absolute;top:42%;width:10%;height:17%;background:var(--blue, #1760dd)}.ds-one{left:7%}.ds-two{right:7%}.ds-card{background:var(--white, #fff);border-radius:16px;overflow:hidden;font-family:\"DM Sans\", sans-serif;color:var(--ink, #142b43)}.ds-art{height:160px;position:relative;background:#e8effd;display:flex;align-items:center;justify-content:center;overflow:hidden}.ds-art .ds-coin{z-index:1;transform:rotate(-12deg)}.ds-art-orbit{position:absolute;border:1px solid #a5bde7;border-radius:50%;height:160px;width:160px}.ds-orbit-one{transform:translate(40px,-44px)}.ds-orbit-two{transform:translate(-50px,48px);width:190px;height:190px}.ds-dot{position:absolute;width:8px;height:8px;background:#86a9e2;border-radius:50%}.ds-dot-one{top:28px;left:30px}.ds-dot-two{bottom:24px;right:24px;width:5px;height:5px}.ds-copy{padding:16px}.ds-small{font-size:11px;font-weight:500;color:var(--muted, #526779)}.ds-copy h3{font-family:\"Manrope\", sans-serif;font-size:15px;font-weight:700;letter-spacing:-.015em;margin:8px 0}.ds-copy p{font-size:12px;line-height:1.6;color:var(--muted, #526779);margin:0 0 12px}.ds-stamp{font-size:10px;display:flex;align-items:center;gap:4px;color:var(--blue, #1760dd)}.ds-stamp svg{width:14px;height:14px}"
