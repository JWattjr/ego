      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#\" aria-current=\"page\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 8V5a2 2 0 0 0-2-2H6a3 3 0 0 0 0 6h14v12H6a3 3 0 0 1-3-3V6\"/><path d=\"M16 13h6v4h-6z\"/></svg><span>Wallet</span></a><a href=\"#\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3zM9 3v15M15 6v15\"/></svg><span>Explore</span></a><a href=\"#\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m16 8-3 5-5 3 3-5z\"/></svg><span>Find</span></a><a href=\"#\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg><span>Drop</span></a></nav>",
      "css": ".ds-nav{display:flex;justify-content:space-around;padding:12px 12px calc(12px + env(safe-area-inset-bottom));background:var(--white, #fff);border-top:1px solid var(--line, #dce4ed);font-family:\"DM Sans\", sans-serif}.ds-nav a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;min-width:62px;min-height:46px;color:var(--muted, #526779);font-size:11px;font-weight:500;border-radius:12px;text-decoration:none}.ds-nav a[aria-current=\"page\"]{color:var(--blue, #1760dd)}.ds-nav a:hover{background:var(--paper, #f6f8fb)}.ds-nav a:focus-visible{outline:3px solid var(--blue, #1760dd);outline-offset:4px}@media(min-width:900px){.ds-nav{padding:16px 20px}.ds-nav a{flex-direction:row;gap:9px;font-size:13px;min-width:100px}}"
